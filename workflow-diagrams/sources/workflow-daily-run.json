  "cards": [
    {
      "dot": "cyan",
      "title": "Finding and scoring jobs",
      "items": [
        "Searches go roles first, then cities, at most 24 a run, and only jobs posted in the last 7 days count",
        "Jobs not seen before are read first; jobs read earlier only fill the gap, so a quiet day is not wasted on repeats",
        "Skills 35, experience 20, role 15, salary 11, location 7, education 5, posted recently 7; 80 or more is ACCEPT",
        "Plain code decides; the AI only reads the job text (repeated text in long postings is trimmed first)"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the email contains",
      "items": [
        "Part 1: up to 6 company-website jobs scoring 80 or more, each with its direct apply link",
        "Part 2: jobs the app applied to for you on Naukri since the last digest",
        "Part 3: where recent company-website jobs stand: waiting for your answer, applied, not applied or ignored"
      ]
    },
    {
      "dot": "violet",
      "title": "Keeping your phone reachable",
      "items": [
        "The listener holds the PC awake 06:00-23:00 so /apply is heard; the guard restarts it within 10 minutes if Windows ended it",
        "One Daily check message at 10:50: no message means the PC or its internet is down",
        "A 19:00 reminder if jobs are waiting, and the 20:00 question: did you apply on the company site?"
      ]
    },
    {
      "dot": "rose",
      "title": "Safeguards",
      "items": [
        "Nothing is applied during the daily run, and the company-site button is never pressed (that marks the job Applied)",
        "A failed refresh, ping or Excel step never stops the run; short pauses between pages keep the request rate low",
        "Watchdog alerts you at 10:30 and 15:00 if something broke"
      ]
    }
  ]
